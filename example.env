# انسخ هذا الملف إلى .env (أو ضع القيم نفسها في .streamlit/secrets.toml)
AI_PROVIDER=gemini            # gemini | groq
GEMINI_API_KEY=
GROQ_API_KEY=
APP_URL=                      # اختياري: https://your-app.streamlit.app
# اختياري: تخصيص سلاسل النماذج والحدود
# GEMINI_MODEL_CHAIN=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash
# GROQ_MODEL_CHAIN=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
# GEMINI_RPM=8
# GROQ_RPM=20
# GROQ_MAX_CHARS=12000
# GROQ_MAX_TOKENS=5000
